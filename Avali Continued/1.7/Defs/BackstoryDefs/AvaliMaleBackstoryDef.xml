  <!-- AvaliMaleGeneticallyEditedWarrior -->
  <AlienRace.AlienBackstoryDef Name="AvaliMaleGeneticallyEditedWarrior" Abstract="True">
    <title>Genetically edited</title>
    <titleShort>Genetically edited</titleShort>
    <description>Before being hatched [PAWN_nameDef] was genetically edited to be a warrior. [PAWN_pronoun] was perfect for almost any combat scenario, being able to take on any foe at an early age. But [PAWN_pronoun] lacked social graces and [PAWN_possessive] education in many areas was brief.</description>
    <slot>Childhood</slot>
    <bodyTypeGlobal>Thin</bodyTypeGlobal>
    <maleCommonality>100</maleCommonality>
    <femaleCommonality>100</femaleCommonality>
    <spawnCategories>
      <li>AvaliBackstory</li>
    </spawnCategories>
    <skillGains>
      <Social>-6</Social>
      <Shooting>10</Shooting>
      <Melee>8</Melee>
    </skillGains>
    <workDisables>
      <li>ManualSkilled</li>
      <li>Intellectual</li>
      <li>Caring</li>
    </workDisables>
    <forcedHediffs>
      <li>GuardianNanites</li>
    </forcedHediffs>
  </AlienRace.AlienBackstoryDef>
   
