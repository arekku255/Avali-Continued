  </AlienRace.AlienBackstoryDef>
   
   <!-- AvaliMaleGeneticallyEditedSocial -->
  <AlienRace.AlienBackstoryDef Name="AvaliMaleGeneticallyEditedSocial" Abstract="True">
    <title>Genetically edited</title>
    <titleShort>Genetically edited</titleShort>
    <description>Before being hatched [PAWN_nameDef] was genetically edited to be very social. [PAWN_pronoun] began speaking at a much younger age then most Avali hatchlings and at the age of four, [PAWN_pronoun] was quickly gaining the ability to persuade others and learn their likes and dislikes. With time it became obvious [PAWN_pronoun] refused to do harm to others and found [PAWN_possessive]self hating dumb and unskilled labour.</description>
    <slot>Childhood</slot>
    <bodyTypeGlobal>Thin</bodyTypeGlobal>
    <maleCommonality>100</maleCommonality>
    <femaleCommonality>100</femaleCommonality>
    <spawnCategories>
      <li>AvaliBackstory</li>
    </spawnCategories>
    <skillGains>
      <Social>10</Social>
      <Construction>-8</Construction>
      <Plants>-6</Plants>
    </skillGains>
    <workDisables>
      <li>ManualDumb</li>
      <li>Violent</li>
    </workDisables>
    <forcedHediffs>
      <li>GuardianNanites</li>
    </forcedHediffs>
